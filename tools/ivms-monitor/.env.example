# คัดลอกไฟล์นี้เป็น .env ในโฟลเดอร์เดียวกัน แล้วใส่ค่าจริง
# ไฟล์ .env อยู่ใน .gitignore แล้ว — ห้าม commit และห้ามส่งต่อทางแชท

# Supabase project ของ portal (Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key (ข้าม RLS ได้ทั้งหมด) — ใช้เฉพาะบนคอม HQ เครื่องนี้
SUPABASE_SERVICE_ROLE_KEY=

# บัญชีผู้ส่งเมล + App Password 16 หลัก (ใส่ติดกัน ไม่มีช่องว่าง)
GMAIL_USER=batacctv.center@gmail.com
GMAIL_APP_PASSWORD=

# ลิงก์ portal สำหรับปุ่ม "เปิดใน Command Center" ในเมล (ไม่ใส่ก็ได้)
PORTAL_URL=

# ---- แหล่งข้อมูลสถานะ DVR (2.0.0) ----
# hpp = Hik-Partner Pro (ค่าเริ่มต้น) · ivms = อ่านหน้าจอ iVMS แบบเดิม (ใช้ย้อนกลับ)
MONITOR_SOURCE=hpp
# ลิงก์หน้า Site & Device › Site (คัดลอกจากแถบที่อยู่หลังเปิดหน้านั้น) — ไม่ใส่ก็ได้ สคริปต์คลิกเมนูเอง
HPP_SITE_URL=
# ใส่ไว้ให้ล็อกอินใหม่เองเมื่อ session หมด (ถ้าเว็บถาม captcha/OTP ต้องรัน --setup เอง) — ไม่ใส่ก็ได้
HPP_USER=
HPP_PASSWORD=
# msedge (ค่าเริ่มต้น ใช้ Edge ที่มีใน Windows) | chrome | chromium
HPP_BROWSER=msedge
# offscreen = หน้าต่างจริงแต่อยู่นอกจอ (ค่าเริ่มต้น — HPP ไม่รับแบบ headless) · show = เห็นหน้าต่าง · headless
HPP_WINDOW=offscreen
