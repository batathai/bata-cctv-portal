# คัดลอกไฟล์นี้เป็น .env ในโฟลเดอร์เดียวกัน แล้วใส่ค่าจริง
# ไฟล์ .env อยู่ใน .gitignore แล้ว — ห้าม commit และห้ามส่งต่อทางแชท

# Supabase project ของ portal (Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key (ข้าม RLS ได้ทั้งหมด) — ใช้เฉพาะบนคอม HQ เครื่องนี้
SUPABASE_SERVICE_ROLE_KEY=

# บัญชีผู้ส่งเมล + App Password 16 หลัก (ใส่ติดกัน ไม่มีช่องว่าง)
GMAIL_USER=batacctv.center@gmail.com
GMAIL_APP_PASSWORD=

# ลิงก์ portal สำหรับปุ่ม "เปิดใน Command Center" ในเมล (ไม่ใส่ก็ได้)
PORTAL_URL=
